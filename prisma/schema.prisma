generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SubmissionStatus {
  pending
  completed
  failed
}

model Submission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status       SubmissionStatus @default(pending)
  ipAddress    String?
  errorMessage String?          @db.Text

  // Q1 — work situation
  workSituation String

  // Q2 — using AI tools regularly
  usingAiTools String

  // Q3 — #1 AI challenge
  aiChallenge String

  // Q4 — desired outcome
  desiredOutcome String

  // Q5 — biggest time drain
  timeDrain String

  // Q6 — data privacy/security worry
  privacyConcern String

  // Q7 — industry
  industry      String
  industryOther String?

  // Q8 — lead response (nullable only for submissions created before this question existed)
  leadResponse String?

  // Q9 — sports fan
  sportsFan    String
  favoriteTeam String?

  // Contact info
  firstName    String
  lastName     String
  businessName String
  email        String
  phone        String?
  websiteUrl   String?
  noWebsite    Boolean @default(false)

  // Gary funnel correlation — set only when this submission originated from a Gary handoff
  funnelCorrelationId String?

  // Generated result
  resultHtml String? @db.Text

  @@index([ipAddress, createdAt])
  @@index([email])
  @@index([funnelCorrelationId])
}

// ---------------------------------------------------------------------------
// Gary Wigglesworth public chat — Phases 1-3 (shell, live chat, assessment
// handoff). No scheduling/video/SMS models here; those phases are out of
// scope for this pass (see the Gary implementation plan).
// ---------------------------------------------------------------------------

enum GaryChatSessionStatus {
  active
  minimized
  handed_off_to_assessment
  ended
}

enum GaryChatMessageRole {
  visitor
  gary
  system
}

enum GarySafetyClass {
  none
  sensitive
}

model PublicChatSession {
  id     String                @id @default(cuid())
  status GaryChatSessionStatus @default(active)

  anonymousId String
  ipAddress   String?

  startedAt      DateTime @default(now())
  lastActivityAt DateTime @updatedAt

  // Analytics-only counters — never used as a hard gate for the assessment offer.
  visitorTurnCount     Int @default(0)
  assessmentOfferCount Int @default(0)

  currentPage String?
  referrer    String?
  utm         Json?

  identifiedContactId String?
  contact             PublicContact? @relation(fields: [identifiedContactId], references: [id])

  handedOffAt DateTime?

  messages PublicChatMessage[]
  handoff  AssessmentHandoff?

  @@index([anonymousId])
  @@index([status, lastActivityAt])
}

model PublicChatMessage {
  id String @id @default(cuid())

  sessionId String
  session   PublicChatSession @relation(fields: [sessionId], references: [id])

  role         GaryChatMessageRole
  content      String              @db.Text
  optionPayload Json?
  safetyClass  GarySafetyClass     @default(none)

  // Which model actually produced this message (gary-role rows only) — the primary model, the
  // fallback (if it were ever invoked), or "fallback" for the deterministic safe reply.
  model String?

  responseValidationResult Json?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

model PublicContact {
  id String @id @default(cuid())

  firstName    String?
  businessName String?

  phoneNormalized String?
  emailNormalized String?

  preferredContactTime String?

  consentGivenAt DateTime?
  consentText    String?   @db.Text

  sourceSessionId String?

  sessions PublicChatSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailNormalized])
  @@index([phoneNormalized])
}

model AssessmentHandoff {
  id String @id @default(cuid())

  sessionId String            @unique
  session   PublicChatSession @relation(fields: [sessionId], references: [id])

  // Only a hash of the signed token is stored — a DB read alone can never mint a valid handoff.
  signedTokenHash      String
  allowedPrefillFields Json

  expiresAt  DateTime
  consumedAt DateTime?

  submissionId String?

  createdAt DateTime @default(now())
}

// Durable, retryable delivery of funnel events to the Command Center's public-funnel endpoint.
// Retry metadata (attempts/nextAttemptAt/lastError) is real and exercised by
// lib/gary/funnelEvents.ts's drainFunnelEventOutbox(), both opportunistically and via a
// dedicated route — see that module for exactly what "retry" does and doesn't cover yet.
model FunnelEventOutbox {
  id             String    @id @default(cuid())
  eventType      String
  eventVersion   Int       @default(1)
  payload        Json
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  deliveredAt    DateTime?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([deliveredAt, nextAttemptAt])
}

// A pending event for a future CRR system — not built yet, but contact-capture moments are
// recorded now so nothing is lost once CRR exists to consume them.
model CrrOutboxEvent {
  id              String    @id @default(cuid())
  eventType       String    @default("contact.captured")
  contactSnapshot Json
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?
}
