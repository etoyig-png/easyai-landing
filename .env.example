# Copy this file to .env.local for local development.
# In production, set these as Vercel Environment Variables — never commit real values.

# Supabase Postgres — Project Settings > Database > Connection string
# Pooled connection (Transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for running migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Resend - the sending domain mail.easyaiconsult.com is verified.
# NOT YET VERIFIED: the root domain easyaiconsult.com. Until Resend verifies it and its DNS
# records are published, the From address must stay on mail.easyaiconsult.com or mail will
# fail authentication and be quarantined. See lib/emailRouting.ts.
RESEND_API_KEY="re_..."

# PRODUCTION SCOPE ONLY. Where the system notifies Easy AI that an ASSESSMENT was completed.
# This is an internal notification, not a contact address. Do NOT set these in Preview or
# Development: preview traffic must never reach a real business inbox.
ASSESSMENT_NOTIFICATION_EMAIL="info@easyaiconsult.com"
# PRODUCTION SCOPE ONLY. Where a customer replying to their Action Plan lands. Product
# direction 2026-09-14: the primary contact address (the code default when unset).
RESULT_EMAIL_REPLY_TO="hello@easyaiconsult.com"
# Optional. Where Gary's contact requests are delivered. Defaults to the primary contact
# address hello@easyaiconsult.com (lib/emailRouting.ts). This is the one destination a
# white-label site configures differently.
# CONTACT_NOTIFICATION_EMAIL="hello@easyaiconsult.com"

# PREVIEW AND DEVELOPMENT SCOPE ONLY. A controlled testing inbox you own.
# Outside production, every send is redirected here. If this is unset, non-production sends
# are refused with an error rather than silently dropped, so no preview, local run, or
# continuous-integration job can email a real customer or the production business inbox.
# Only VERCEL_ENV="production" is ever allowed to reach the intended recipient.
EMAIL_TEST_RECIPIENT=""

# Optional sender overrides. LEAVE THESE UNSET. The defaults in lib/emailRouting.ts already
# use the authenticated mail.easyaiconsult.com senders. Do not point either at
# info@easyaiconsult.com until the root domain is verified inside Resend and its DomainKeys
# Identified Mail and Sender Policy Framework records are published.
# NOTIFICATION_EMAIL_FROM="Easy AI Assessments <assessments@mail.easyaiconsult.com>"
# RESULT_EMAIL_FROM="Easy AI <hello@mail.easyaiconsult.com>"

# Claude API — used server-side to generate the personalized AI Action Plan
ANTHROPIC_API_KEY="sk-ant-..."

# Easy AI Command Center (separate mr-life-command-center deployment) — status-only ping.
# URL is that deployment's real domain + /api/easy-ai/leads. Secret must equal the
# EASY_AI_LEAD_WEBHOOK_TOKEN configured on that deployment.
COMMAND_CENTER_WEBHOOK_URL="https://<your-command-center-domain>/api/easy-ai/leads"
COMMAND_CENTER_WEBHOOK_SECRET="same value as EASY_AI_LEAD_WEBHOOK_TOKEN on mr-life-command-center"

# --- Site / assistant identity (lib/siteConfig.ts) ---
# All optional; the defaults resolve to Easy AI, Gary / AIM, hello@easyaiconsult.com. Read on
# the server only. A visitor's browser can never choose which site or organisation owns a
# contact record: ownership is derived from these values.
# SITE_KEY="easy-ai"
# SITE_BRAND_NAME="Easy AI"
# ASSISTANT_NAME="Gary"
# ASSISTANT_PROGRAM_NAME="AIM"
# The upfront AI disclosure, first sentence of Gary's first message and of the contact flow.
# ASSISTANT_DISCLOSURE="Hi, I'm Gary, Easy AI's AI assistant."
# CONTACT_CHANNEL_LABEL="Gary contact request"
# CONTACT_CHANNEL_KEY="assistant-contact-flow"
# BOOKING_PATH="/book-consultation"
# ASSISTANT_CONTACT_FLOW_ENABLED="true"
# ASSISTANT_ASSESSMENT_HANDOFF_ENABLED="true"

# --- Gary Wigglesworth (public chatbot) ---

# Provider adapter selection. GARY_LLM_MODEL has no code default on purpose — it must be set
# explicitly (e.g. "gpt-5.4-mini" for openai, or an Anthropic model id for anthropic).
GARY_LLM_PROVIDER="openai"
GARY_LLM_MODEL="gpt-5.4-mini"
# Optional — only needed for an OpenAI-compatible provider other than api.openai.com (e.g. a
# future DeepSeek/Qwen adapter reusing the same Chat Completions client).
GARY_LLM_BASE_URL=""
# Optional — read and validated at boot, but never auto-invoked by the reply pipeline today (see
# lib/gary/llm/providerFactory.ts). Leave both unset unless a deliberate fallback rollout has
# been decided.
GARY_LLM_FALLBACK_PROVIDER=""
GARY_LLM_FALLBACK_MODEL=""
# Required if GARY_LLM_PROVIDER=openai
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY above is reused if GARY_LLM_PROVIDER=anthropic

# HMAC secret used to sign the short-lived assessment-handoff token in the Gary -> /assessment
# URL. Any long random string; only this server ever verifies it.
GARY_HANDOFF_TOKEN_SECRET="generate a long random string"

# HMAC secret for the Gary session capability — the short-lived token that binds a browser to
# its own chat session, so a caller cannot drive someone else's sessionId on /api/gary/message
# or /api/gary/handoff. Any long random string; only this server ever verifies it. Use a
# DIFFERENT value from GARY_HANDOFF_TOKEN_SECRET above.
#
# TRANSITIONAL COMPATIBILITY: if this is unset, lib/gary/sessionCapability.ts falls back to
# GARY_HANDOFF_TOKEN_SECRET so environments provisioned before this variable existed keep
# working rather than failing closed and taking Gary offline. Signatures are domain-separated
# ("gary-session:" prefix), so the two uses cannot be confused even while sharing a value.
# Set this explicitly in every environment; the fallback is then unused and can be removed in
# a later pass.
GARY_SESSION_CAPABILITY_SECRET="generate a long random string, different from GARY_HANDOFF_TOKEN_SECRET"

# Gary's own conversation-summary/funnel-correlation events (chat.session.started,
# chat.message.rollup, contact.captured, assessment.started) — separate from the COMPLETE
# assessment payload below. URL is the Command Center deployment's real domain +
# /api/easy-ai/public-funnel/events. Secret must equal EASY_AI_PUBLIC_FUNNEL_WEBHOOK_TOKEN
# configured on that deployment.
GARY_FUNNEL_WEBHOOK_URL="https://<your-command-center-domain>/api/easy-ai/public-funnel/events"
GARY_FUNNEL_WEBHOOK_SECRET="same value as EASY_AI_PUBLIC_FUNNEL_WEBHOOK_TOKEN on mr-life-command-center"
# Protects /api/gary/funnel-outbox/drain: POST retries undelivered funnel events (a future
# cron target); GET is the contact-pipeline health check (200 ok / 503 with named problems)
# for an uptime checker. See docs/gary-contact-pipeline.md.
GARY_FUNNEL_DRAIN_SECRET="generate a long random string"
# PRODUCTION ONLY. Set any long random string and Vercel sends it as "Authorization: Bearer"
# on the cron declared in vercel.json (GET /api/gary/funnel-outbox/drain), which retries
# undelivered Command Center handoffs. Without it the scheduled call is rejected with 401.
CRON_SECRET="generate a long random string"

# COMPLETE online-assessment payload (every question/answer, scores, generated result, contact
# info) — separate from the Gary funnel events above. URL is the Command Center deployment's
# real domain + /api/easy-ai/assessments. Token must equal that deployment's EASY_AI_SYNC_TOKEN
# (the existing legacy sync token, reused here — not a new one).
COMMAND_CENTER_ASSESSMENT_SYNC_URL="https://<your-command-center-domain>/api/easy-ai/assessments"
COMMAND_CENTER_ASSESSMENT_SYNC_TOKEN="same value as EASY_AI_SYNC_TOKEN on mr-life-command-center"
