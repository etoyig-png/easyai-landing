# Copy this file to .env.local for local development.
# In production, set these as Vercel Environment Variables — never commit real values.

# Supabase Postgres — Project Settings > Database > Connection string
# Pooled connection (Transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for running migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Resend — domain mail.easyaiconsult.com must already be verified in Resend
RESEND_API_KEY="re_..."
# Internal inbox that gets a notification for every new assessment submission
ASSESSMENT_NOTIFICATION_EMAIL="team@easyaiconsult.com"
# Optional overrides — sensible defaults are already set in lib/resend.ts
NOTIFICATION_EMAIL_FROM="Easy AI Assessments <assessments@mail.easyaiconsult.com>"
RESULT_EMAIL_FROM="Easy AI <hello@mail.easyaiconsult.com>"
# mail.easyaiconsult.com is sending-only — set this to a real monitored inbox
# (e.g. your Google Workspace address) so lead replies land somewhere real.
RESULT_EMAIL_REPLY_TO="hello@easyaiconsult.com"

# Claude API — used server-side to generate the personalized AI Action Plan
ANTHROPIC_API_KEY="sk-ant-..."

# Easy AI Command Center (separate mr-life-command-center deployment) — status-only ping.
# URL is that deployment's real domain + /api/easy-ai/leads. Secret must equal the
# EASY_AI_LEAD_WEBHOOK_TOKEN configured on that deployment.
COMMAND_CENTER_WEBHOOK_URL="https://<your-command-center-domain>/api/easy-ai/leads"
COMMAND_CENTER_WEBHOOK_SECRET="same value as EASY_AI_LEAD_WEBHOOK_TOKEN on mr-life-command-center"

# --- Gary Wigglesworth (public chatbot) ---

# Provider adapter selection. GARY_LLM_MODEL has no code default on purpose — it must be set
# explicitly (e.g. "gpt-5.4-mini" for openai, or an Anthropic model id for anthropic).
GARY_LLM_PROVIDER="openai"
GARY_LLM_MODEL="gpt-5.4-mini"
# Optional — only needed for an OpenAI-compatible provider other than api.openai.com (e.g. a
# future DeepSeek/Qwen adapter reusing the same Chat Completions client).
GARY_LLM_BASE_URL=""
# Optional — read and validated at boot, but never auto-invoked by the reply pipeline today (see
# lib/gary/llm/providerFactory.ts). Leave both unset unless a deliberate fallback rollout has
# been decided.
GARY_LLM_FALLBACK_PROVIDER=""
GARY_LLM_FALLBACK_MODEL=""
# Required if GARY_LLM_PROVIDER=openai
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY above is reused if GARY_LLM_PROVIDER=anthropic

# HMAC secret used to sign the short-lived assessment-handoff token in the Gary -> /assessment
# URL. Any long random string; only this server ever verifies it.
GARY_HANDOFF_TOKEN_SECRET="generate a long random string"

# Gary's own conversation-summary/funnel-correlation events (chat.session.started,
# chat.message.rollup, contact.captured, assessment.started) — separate from the COMPLETE
# assessment payload below. URL is the Command Center deployment's real domain +
# /api/easy-ai/public-funnel/events. Secret must equal EASY_AI_PUBLIC_FUNNEL_WEBHOOK_TOKEN
# configured on that deployment.
GARY_FUNNEL_WEBHOOK_URL="https://<your-command-center-domain>/api/easy-ai/public-funnel/events"
GARY_FUNNEL_WEBHOOK_SECRET="same value as EASY_AI_PUBLIC_FUNNEL_WEBHOOK_TOKEN on mr-life-command-center"
# Protects POST /api/gary/funnel-outbox/drain — a manually/cron-triggerable retry of any
# undelivered funnel event. No Vercel Cron schedule is configured for this yet; see the PR
# description.
GARY_FUNNEL_DRAIN_SECRET="generate a long random string"

# COMPLETE online-assessment payload (every question/answer, scores, generated result, contact
# info) — separate from the Gary funnel events above. URL is the Command Center deployment's
# real domain + /api/easy-ai/assessments. Token must equal that deployment's EASY_AI_SYNC_TOKEN
# (the existing legacy sync token, reused here — not a new one).
COMMAND_CENTER_ASSESSMENT_SYNC_URL="https://<your-command-center-domain>/api/easy-ai/assessments"
COMMAND_CENTER_ASSESSMENT_SYNC_TOKEN="same value as EASY_AI_SYNC_TOKEN on mr-life-command-center"
